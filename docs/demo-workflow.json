{
  "baseUrl": "http://localhost:4000/api/v1",
  "notes": "Run the steps as a COD workflow. Each login replaces the Bearer access token. assign-rider already changes status to OUT_FOR_DELIVERY. For online payment, run one optional checkout after assignment and wait for the signed paid webhook BEFORE delivery; skip COD collection. Never start checkout after delivery.",
  "credentials": {
    "merchant": { "email": "merchant@example.com", "password": "Password123!" },
    "hubManager": {
      "email": "hubmanager@example.com",
      "password": "Password123!"
    },
    "rider": { "email": "rider@example.com", "password": "Password123!" }
  },
  "seedData": {
    "customerId": "COPY_FROM_PNPM_DB_SEED_OUTPUT",
    "originHubId": "COPY_FROM_PNPM_DB_SEED_OUTPUT",
    "destinationHubId": "COPY_FROM_PNPM_DB_SEED_OUTPUT",
    "vehicleId": "COPY_FROM_PNPM_DB_SEED_OUTPUT"
  },
  "steps": [
    {
      "name": "Login merchant",
      "method": "POST",
      "path": "/auth/login",
      "body": { "email": "merchant@example.com", "password": "Password123!" }
    },
    {
      "name": "Create parcel",
      "method": "POST",
      "path": "/parcels",
      "body": {
        "customerId": "{{customerId}}",
        "pickupAddress": "Motijheel, Dhaka",
        "deliveryAddress": "Uttara, Dhaka",
        "weightGrams": 1200,
        "codAmount": 500
      }
    },
    {
      "name": "Assign origin hub",
      "method": "POST",
      "path": "/parcels/{{parcelId}}/assign-origin-hub",
      "body": { "hubId": "{{originHubId}}" }
    },
    {
      "name": "Login hub manager",
      "method": "POST",
      "path": "/auth/login",
      "body": { "email": "hubmanager@example.com", "password": "Password123!" }
    },
    {
      "name": "Dispatch to destination",
      "method": "POST",
      "path": "/parcels/{{parcelId}}/dispatch",
      "body": {
        "destinationHubId": "{{destinationHubId}}",
        "vehicleId": "{{vehicleId}}"
      }
    },
    {
      "name": "Mark arrived",
      "method": "POST",
      "path": "/parcels/{{parcelId}}/mark-arrived",
      "body": {}
    },
    {
      "name": "Assign rider",
      "method": "POST",
      "path": "/parcels/{{parcelId}}/assign-rider",
      "body": {
        "riderId": "COPY_RIDER_ID_FROM_DB_OR_SEED"
      }
    },
    {
      "name": "Login assigned rider",
      "method": "POST",
      "path": "/auth/login",
      "body": {
        "email": "rider@example.com",
        "password": "Password123!"
      }
    },
    {
      "name": "Delivered",
      "method": "PATCH",
      "path": "/parcels/{{parcelId}}/status",
      "body": { "status": "DELIVERED", "note": "Delivered to customer" }
    }
  ],
  "optionalOnlinePaymentBeforeDelivery": [
    {
      "name": "Stripe checkout (use merchant or admin token)",
      "method": "POST",
      "path": "/payments/stripe/checkout",
      "body": { "parcelId": "{{parcelId}}" }
    },
    {
      "name": "Customer Stripe checkout at delivery",
      "method": "POST",
      "path": "/payments/stripe/customer-checkout",
      "body": {
        "trackingNumber": "{{trackingNumber}}",
        "phone": "{{customerPhone}}"
      }
    }
  ]
}
